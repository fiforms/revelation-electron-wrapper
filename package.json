{
  "name": "revelation-electron",
  "version": "1.0.13",
  "main": "main.js",
  "description": "A modular presentation builder for Reveal.js with integrated media management.",
  "author": {
    "name": "Daniel McFeeters",
    "email": "subscriptions@pastordaniel.net"
  },
  "build": {
    "appId": "com.revelation.snapshot",
    "productName": "REVELation Snapshot Presenter",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!WordPress/**",
      "!revelation/**",
      "!plugins/**",
      "!http_admin/**",
      "!bin/**",
      "!scripts/**",
      "!gnome-extension/**",
      "!node_modules/**/coverage/**",
      "!node_modules/**/.nyc_output/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/spec/**",
      "!node_modules/**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "revel",
        "name": "REVELation Presentation",
        "description": "REVELation Presentation",
        "mimeType": "application/vnd.revelation.presentation+zip",
        "icon": "file-icon",
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "revelation",
        "to": "revelation",
        "filter": [
          "**/*",
          "!tests/**",
          "!revelation_file_summary.txt",
          "!package-lock.json"
        ]
      },
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "http_admin",
        "to": "http_admin"
      },
      {
        "from": "gnome-extension",
        "to": "gnome-extension"
      },
      {
        "from": "revelation/node_modules",
        "to": "revelation/node_modules",
        "filter": [
          "**/*",
          "!**/.bin/**"
        ]
      },
      {
        "from": "bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.revelation.snapshot.presentation",
            "UTTypeDescription": "REVELation Presentation",
            "UTTypeConformsTo": [
              "public.zip-archive"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "revel"
              ],
              "public.mime-type": "application/vnd.revelation.presentation+zip"
            }
          }
        ]
      }
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "Daniel McFeeters <subscriptions@pastordaniel.net>",
      "description": "A modular presentation builder for Reveal.js with media management.",
      "artifactName": "${name}-${version}.${ext}",
      "executableName": "revelation-electron"
    },
    "deb": {
      "recommends": [
        "libappindicator3-1",
        "poppler-utils"
      ]
    },
    "rpm": {
      "fpm": [
        "--rpm-tag",
        "Recommends: poppler-utils"
      ]
    }
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "postinstall": "node scripts/postinstall.js",
    "fetch-blobs": "node scripts/fetch-blobs.js",
    "fetch-wordpress-libs": "node scripts/fetch-wordpress-libs.js",
    "start": "cross-env ELECTRON_DISABLE_SANDBOX=true electron .",
    "dev": "concurrently \"cd revelation && npm run watch:theme\" \"cross-env ELECTRON_DISABLE_SANDBOX=true electron .\"",
    "build": "cd revelation && npm run build && cd .. && node scripts/fetch-oldcss.js && node scripts/fetch-theme-thumbnails.js && node scripts/copy-theme-thumbnails.js && node scripts/copy-plugins.js && node scripts/build-offline-plugins.js && npm run wp:sync-runtime && npm run wp:package",
    "build-popplerpdf-win": "node scripts/build-popplerpdf-win.js",
    "build-popplerpdf-mac": "node scripts/build-popplerpdf-mac.js",
    "build:offline-plugins": "node scripts/build-offline-plugins.js",
    "dist-popplerpdf-win": "node scripts/dist-popplerpdf.js",
    "dist-popplerpdf-mac": "node scripts/dist-popplerpdf.js",
    "dist-win": "npm run build && node scripts/package.js --win",
    "dist-linux": "npm run build && node scripts/package.js --linux",
    "dist-mac": "npm run build && node scripts/package.js --mac",
    "dist-mac-intel": "npm run build && node scripts/package.js --mac --x64",
    "llm:dump": "node revelation/scripts/dump-for-llm.js revelation_electron_file_summary.txt",
    "wp:sync-runtime": "node scripts/wp-sync-runtime-assets.js",
    "wp:package": "npm run wp:sync-runtime && node scripts/wp-package-plugin.js",
    "build:wp": "npm run wp:package"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bonjour-service": "^1.4.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "ical.js": "^2.2.1",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "socket.io": "^4.8.3",
    "unzipper": "^0.12.3",
    "which": "^6.0.1",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.3"
    }
  }
}
